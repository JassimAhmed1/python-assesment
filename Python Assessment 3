total = 0
shopping = True
cart = []

while shopping:
    choice = input("enter your choice of product (type 'exit') ") # user input
    if choice == "exit":
        shopping = False
    elif choice in menu:
        price = menu[choice]
        total = total + price
        cart.append(choice)
    else:
        print("not found")

print(f"subtotal [{total}] ")

if total >= 30000:
    discount = total * 0.10
    total -=discount
    print(f"10% applied ")   
