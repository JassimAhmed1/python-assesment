print("Welcome to the Password Strength checker")

password = input("Enter your password")
score = 0


if len(password) >= 12:
    score += 2
elif len(password) >=8:
    score += 1

    

if any(cap.isupper() for cap in password):  #any() is a inbuilt function that helps us check if atleast one uppercase is found in the password
    score += 2
    print("Uppercase found")                
else:
    print("Uppercase not found")
 

if any(digit.isdigit() for digit in password):
    print("digit found")
    score += 2
else:
    print("digit not found")
         

if any(low.islower() for low in password):
    print("lowercase found")
    score += 2
else:
    print("lowercase not found")
    
special_characters = "!@#$%^&*()-_=+[]{}|;:',.<>?/~`¬~"

if any(cap in special_characters for cap in password):
    score += 2
    print("Special character found")
else:
    print("Special charcter not found")
        

if score >=9:
    print("password stength strong")
elif score >=8:
    print("password strength medium")
else:
    print("invalid")
    
